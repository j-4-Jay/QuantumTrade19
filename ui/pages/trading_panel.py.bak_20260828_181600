"""Trading Panel tab - Futures-only chart foundation.

PATH: ui/pages/trading_panel.py  (REPLACE ENTIRE FILE)

CHANGE (v0.3.7):
- Removed the repeated "Trading Panel" page heading (sidebar already shows
  the active page - matches Dashboard's existing behavior).
- Removed the always-visible chart-control button bar entirely.
- Grid, Reset View, Day/Night, Follow Live, and Go to Live now live inside
  a real Reflex right-click context menu (rx.context_menu), wrapping the
  chart. These are genuine Reflex-bound menu items - not custom JS - so
  they are exactly as reliable as any other button in the app.
- Double-clicking anywhere inside the chart now also calls
  reset_trading_panel_view() (same action as the menu's Reset View item).
- Display Last X Days is now a per-symbol setting (applies across 1m/5m/
  15m automatically) - see state/app_state_mixins/trading_panel_mixin.py.
- Added the soft hover-glow class to the main card.
"""
from __future__ import annotations

import reflex as rx

from state.app_state import AppState, TRADING_PANEL_TF_OPTIONS
from ui.components.trading_panel_chart import trading_panel_chart
from ui.theme.glass import GLASS_CARD_3XL_STYLE, HOVER_GLOW_CLASS


def _ohlc_pill(label: str, value) -> rx.Component:
    return rx.hstack(
        rx.text(label, font_size="0.7rem", color="var(--qt19-text-muted)"),
        rx.text(value, font_size="0.82rem", font_weight="700"),
        spacing="1",
    )


def _tf_buttons() -> rx.Component:
    return rx.hstack(
        *[
            rx.button(
                tf,
                size="1",
                variant=rx.cond(
                    AppState.trading_panel_chart_tf == tf,
                    "solid",
                    "outline",
                ),
                on_click=AppState.set_trading_panel_chart_tf(tf),
            )
            for tf in TRADING_PANEL_TF_OPTIONS
        ],
        spacing="1",
    )


def _header() -> rx.Component:
    return rx.hstack(
        rx.select(
            AppState.trading_panel_symbol_options,
            value=AppState.trading_panel_symbol,
            on_change=AppState.set_trading_panel_symbol,
            width="170px",
        ),
        _tf_buttons(),
        rx.spacer(),
        _ohlc_pill("O", AppState.trading_panel_current_open),
        _ohlc_pill("H", AppState.trading_panel_current_high),
        _ohlc_pill("L", AppState.trading_panel_current_low),
        _ohlc_pill("C", AppState.trading_panel_current_close),
        rx.badge(AppState.ws_status, variant="soft"),
        width="100%",
        align_items="center",
        spacing="4",
        wrap="wrap",
    )


def _display_window_controls() -> rx.Component:
    return rx.hstack(
        rx.text("Display Last:", font_size="0.8rem"),
        rx.input(
            value=AppState.trading_panel_display_days_draft,
            on_change=AppState.set_trading_panel_display_days_draft,
            on_blur=AppState.commit_trading_panel_display_days,
            width="70px",
            size="1",
        ),
        rx.text("Days (applies to 1m/5m/15m for this symbol)", font_size="0.75rem", color="var(--qt19-text-muted)"),
        rx.button(
            "Apply",
            size="1",
            variant="outline",
            on_click=AppState.commit_trading_panel_display_days,
        ),
        rx.divider(orientation="vertical", height="1.2rem"),
        rx.text(
            f"Local: {AppState.trading_panel_local_days} days",
            font_size="0.75rem",
            color="var(--qt19-text-muted)",
        ),
        rx.text(
            f"Broker: {AppState.trading_panel_broker_days}",
            font_size="0.75rem",
            color="var(--qt19-text-muted)",
        ),
        rx.cond(
            AppState.trading_panel_notice != "",
            rx.badge(
                AppState.trading_panel_notice,
                color_scheme="orange",
                variant="soft",
            ),
        ),
        spacing="3",
        align_items="center",
        wrap="wrap",
    )


def _context_menu_item(label: str, on_click) -> rx.Component:
    return rx.context_menu.item(label, on_click=on_click)


def _chart_with_context_menu() -> rx.Component:
    return rx.context_menu.root(
        rx.context_menu.trigger(
            rx.box(
                trading_panel_chart(),
                on_double_click=AppState.reset_trading_panel_view,
                width="100%",
            )
        ),
        rx.context_menu.content(
            _context_menu_item(
                rx.cond(AppState.trading_panel_grid_enabled, "Hide Grid", "Show Grid"),
                AppState.toggle_trading_panel_grid,
            ),
            rx.context_menu.separator(),
            _context_menu_item("Reset View", AppState.reset_trading_panel_view),
            rx.context_menu.separator(),
            _context_menu_item(
                rx.cond(AppState.trading_panel_chart_theme == "night", "Day Mode", "Night Mode"),
                AppState.set_trading_panel_chart_theme(
                    rx.cond(AppState.trading_panel_chart_theme == "night", "day", "night")
                ),
            ),
            rx.context_menu.separator(),
            _context_menu_item(
                rx.cond(AppState.trading_panel_follow_live, "Follow Live: Turn OFF", "Follow Live: Turn ON"),
                AppState.toggle_trading_panel_follow_live,
            ),
            _context_menu_item("Go to Live", AppState.go_live_trading_panel),
        ),
    )


def trading_panel_page() -> rx.Component:
    return rx.box(
        _header(),
        _display_window_controls(),
        _chart_with_context_menu(),
        spacing="3",
        style=GLASS_CARD_3XL_STYLE,
        class_name=HOVER_GLOW_CLASS,
        width="100%",
    )
